<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist. The value comes from Config/Kalyta.xcconfig. -->
	<!-- The App Group of today's total; the value comes from APP_GROUP_ID in Config/Kalyta.xcconfig. -->
	<key>KalytaAppGroup</key>
	<string>$(APP_GROUP_ID)</string>
	<key>KalytaIconBaseURL</key>
	<string>$(ICON_BASE_URL)</string>
	<!-- The opportunistic monobank refresh; the identifier matches MonobankSync.refreshTaskID. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).monobank</string>
	</array>
	<!-- Only the system's HTTPS and Keychain are used, which are exempt from export documentation. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The pages linked from Settings; the values come from Config/Kalyta.xcconfig. -->
	<key>KalytaPrivacyPolicyURL</key>
	<string>$(PRIVACY_POLICY_URL)</string>
	<key>KalytaSupportURL</key>
	<string>$(SUPPORT_URL)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
