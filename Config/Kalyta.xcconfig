// Build settings shared by every configuration of the Kalyta project.
//
// Personal values do not belong here. Put them in Config/Local.xcconfig,
// which git ignores and which is included at the end of this file, so any
// value set there overrides the one below.

PRODUCT_BUNDLE_IDENTIFIER = org.merzlov.kalyta
MARKETING_VERSION = 0.1
CURRENT_PROJECT_VERSION = 1

// Empty so the project builds for the simulator without an Apple account.
// To run on a device, set your team in Config/Local.xcconfig:
//     DEVELOPMENT_TEAM = <your team ID>
// With a free Apple account you may also need a unique bundle identifier:
//     PRODUCT_BUNDLE_IDENTIFIER = com.example.kalyta
DEVELOPMENT_TEAM =

// Where subscription icons are fetched from: homarr-labs/dashboard-icons (Apache-2.0),
// pinned to one commit so a renamed icon cannot silently break. "//" starts a comment
// in xcconfig files, so the scheme separator is written as "/$()/".
ICON_BASE_URL = https:/$()/cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons@cf87d9bbd47792b20893f090ff48763fe874b05d/png

// Shown when the app first asks for the camera to scan a receipt's QR code.
// Translations live in Kalyta/InfoPlist.xcstrings under the same key.
INFOPLIST_KEY_NSCameraUsageDescription = Scan the QR code on a receipt to fill in its amount and time. The code is read on your iPhone; nothing is sent.

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// The App Group the app shares today's total through with its widget. Derived from the
// bundle identifier, so a unique identifier in Local.xcconfig gives a unique group too.
APP_GROUP_ID = group.$(PRODUCT_BUNDLE_IDENTIFIER)

#include? "Local.xcconfig"
