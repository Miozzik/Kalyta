    "Kalyta": {
      "shouldTranslate": false
    },
    "Kalyta Autopay": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автозапис Kalyta"
          }
        }
      }
    },
    "Kalyta can record every Apple Pay payment by itself, with its amount and merchant. iOS lets only you switch this on, in Shortcuts. It takes about a minute.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalyta може сама записувати кожну оплату Apple Pay — із сумою й продавцем. Увімкнути це iOS дозволяє лише тобі, у «Командах». Це займе хвилину."
          }
        }
      }
    },
    "Kalyta is open source under the MIT License.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalyta — відкритий код за ліцензією MIT."
          }
        }
      }
    },
    "Kind": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тип"
          }
        }
      }
    },
    "Leave empty to keep the built-in name.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиш порожнім, щоб лишилась стандартна назва."
          }
        }
      }
    },
    "License": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліцензія"
          }
        }
      }
    },
    "Line %lld is not in hryvnias. Kalyta only imports hryvnia amounts.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядок %lld не в гривнях. Kalyta імпортує лише суми в гривнях."
          }
        }
      }
    },
    "Logos are trademarks of their respective owners.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Логотипи є торговельними марками їхніх власників."
          }
        }
      }
    },
    "Manage tokens at api.monobank.ua": {
      "localizations": {
